# Counsel local-dev environment template.
# Copy to .env and populate. .env is gitignored; .env.example is committed.
#
# Sensitive runtime values (treasury keys, CDP secret, admin token,
# customer API key) live in AWS Secrets Manager in production. Locally,
# Counsel falls back to these env vars when COUNSEL_SECRET_ARN is unset.

# ── Coinbase Developer Platform (x402 facilitator JWT signing) ────────────────
CDP_API_KEY_ID=00000000-0000-0000-0000-000000000000
CDP_API_KEY_SECRET=base64-encoded-ed25519-private-key

# ── Counsel treasury wallets ──────────────────────────────────────────────────
# Receives inbound x402 payments + signs outbound x402 + signs anchor txs.
# Generate fresh keypairs with eth_account.Account.create() and solders.
TREASURY_ADDRESS=0x...
TREASURY_PRIVATE_KEY=0x...
SOLANA_TREASURY_ADDRESS=base58-pubkey
SOLANA_TREASURY_KEY=base58-keypair-bytes

# ── On-chain RPC endpoints ────────────────────────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Demo wallets (for test_e2e.py) ────────────────────────────────────────────
# Client wallet pays Counsel inbound. Officer wallet signs the merkle_root.
# Both must be funded (USDC for client, no funding needed for officer).
CLIENT_PRIVATE_KEY=0x...
CLIENT_ADDRESS=0x...
OFFICER_PRIVATE_KEY=0x...
OFFICER_ADDRESS=0x...
SOLANA_CLIENT_KEY=base58-keypair-bytes
SOLANA_CLIENT_ADDRESS=base58-pubkey
OFFICER_SOLANA_KEY=base58-keypair-bytes
OFFICER_SOLANA_ADDRESS=base58-pubkey

# ── Admin auth + customer API key ─────────────────────────────────────────────
# ADMIN_API_KEY gates /v1/admin/* (officer + customer + erasure CRUD).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# COUNSEL_API_KEY is returned ONCE by POST /v1/admin/customers.
ADMIN_API_KEY=replace-with-token_urlsafe(32)
COUNSEL_API_KEY=ck_live_...
